{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nutrichart/chart.schema.json",
  "title": "Structured Nutrition Chart \u2014 Educational NCP Demo",
  "type": "object",
  "required": [
    "schema_version",
    "terminology_system",
    "patient",
    "assessment",
    "diagnosis",
    "intervention",
    "monitoring_evaluation"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "terminology_system": {
      "type": "string"
    },
    "patient": {
      "type": "object",
      "required": [
        "id",
        "visit_date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name_or_alias": {
          "type": "string"
        },
        "age_years": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "visit_date": {
          "type": "string",
          "format": "date"
        },
        "professional": {
          "type": "string"
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "terminology_category",
        "anthropometrics"
      ],
      "properties": {
        "terminology_category": {
          "type": "string"
        },
        "anthropometrics": {
          "type": "object",
          "properties": {
            "weight_kg": {
              "type": [
                "number",
                "null"
              ]
            },
            "height_cm": {
              "type": [
                "number",
                "null"
              ]
            },
            "bmi_kg_m2": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "food_nutrition_history": {
          "type": "string"
        },
        "biochemical_data": {
          "type": "string"
        },
        "nutrition_focused_physical_findings": {
          "type": "string"
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "required": [
        "problem",
        "etiology",
        "signs_symptoms",
        "pes_statement"
      ],
      "properties": {
        "problem": {
          "type": "string"
        },
        "etiology": {
          "type": "string"
        },
        "signs_symptoms": {
          "type": "string"
        },
        "pes_statement": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "intervention": {
      "type": "object",
      "required": [
        "category",
        "planned_action",
        "goal"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "planned_action": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "follow_up_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "monitoring_evaluation": {
      "type": "object",
      "required": [
        "indicator"
      ],
      "properties": {
        "indicator": {
          "type": "string"
        },
        "baseline": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "progress": {
          "type": "string"
        },
        "outcome_status": {
          "type": "string"
        },
        "review_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "next_steps": {
          "type": "string"
        }
      }
    }
  }
}